{
  "name": "kept-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/sdk",
    "packages/mcp",
    "backend",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w @kept/core && npm run build -w @kept/sdk && npm run build -w @kept/mcp",
    "test": "vitest run",
    "typecheck": "npm run build && npm run typecheck -w @kept/backend",
    "dev": "npm run build -w @kept/core && npm run dev -w @kept/backend",
    "rename": "node scripts/rename.mjs",
    "dev:web": "npm run build -w @kept/core && npm run dev -w @kept/web",
    "build:web": "npm run build -w @kept/web",
    "test:paypal": "vitest run --project paypal",
    "paypal:check": "npm run paypal:check -w @kept/backend",
    "setup:web-env": "node scripts/web-env.mjs"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.16"
  }
}
